{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=travelbuddy;User=root;Password=root;"
  },

  "spring": {
    "application": {
      "name": "Feedback" // mention your app name . Dont use _ in name.
